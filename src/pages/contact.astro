---
import { ArrowUpRight, Mail } from "lucide-astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact — Théo Genty">
  <section class="contact-page page-arrive">
    <div class="contact-kicker"><span>YOUR TURN</span><span>04 / 04</span></div>
    <header class="contact-heading">
      <span class="mb-3 inline-block border border-black bg-white px-3 py-1 font-mono text-xs font-bold uppercase">
        Got an idea?
      </span>
      <h1>
        Let’s talk about<br />your project<span class="text-[#FF6B6B]">.</span>
      </h1>
      <p>
        Tell me about your project, your ideas, or what you need. I’ll get back to you as soon as I can.
      </p>
    </header>

    <div class="contact-content">
      <form id="contact-form" class="contact-form">
        <label>
          Your name
          <input
            name="name"
            type="text"
            autocomplete="name"
            required
            class="contact-input"
            placeholder="First and last name"
          />
        </label>

        <label>
          Your email address
          <input
            name="email"
            type="email"
            autocomplete="email"
            required
            class="contact-input"
            placeholder="you@example.com"
          />
        </label>

        <label>
          Your message
          <textarea
            name="message"
            rows="5"
            required
            class="contact-input"
            placeholder="Tell me about your project..."
          ></textarea>
        </label>

        <p id="contact-status" class="text-sm leading-relaxed" aria-live="polite"></p>

        <button
          type="submit"
          class="contact-submit"
        >
          Send message <ArrowUpRight size={18} />
        </button>
        <p class="form-note">
          This opens your email app with the message filled in. Nothing is stored on this website.
        </p>
      </form>

      <aside class="email-card">
        <div>
          <Mail size={24} strokeWidth={2.4} />
          <h2>Prefer email?</h2>
          <p>
            Get in touch directly. I’d be happy to hear from you.
          </p>
        </div>
        <a
          href="mailto:theo.genty@icloud.com"
          class="email-link"
        >
          theo.genty@icloud.com
        </a>
      </aside>
    </div>
  </section>

  <script>
    const contactEmail = "theo.genty@icloud.com";

    function setupContactForm() {
      const form = document.querySelector<HTMLFormElement>("#contact-form");
      const status = document.querySelector<HTMLElement>("#contact-status");
      if (!form || !status || form.dataset.ready === "true") return;

      form.dataset.ready = "true";
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const values = new FormData(form);
        const name = String(values.get("name") ?? "").trim();
        const email = String(values.get("email") ?? "").trim();
        const message = String(values.get("message") ?? "").trim();
        const subject = encodeURIComponent(`Portfolio message — ${name}`);
        const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);

        status.textContent = "Your email app will open with your message ready to send.";
        window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
      });
    }

    document.addEventListener("astro:page-load", setupContactForm);
    setupContactForm();
  </script>
</Layout>

<style>
  .contact-page {
    padding-bottom: 1rem;
  }

  .contact-kicker {
    display: flex;
    justify-content: space-between;
    padding: 0.2rem 0 0.8rem;
    font-family: "Space Mono", monospace;
    font-size: 0.55rem;
    font-weight: 700;
  }

  .contact-heading {
    border: 1.5px solid #151515;
    background: #7dffb3;
    padding: 1rem;
    box-shadow: 4px 4px 0 #151515;
  }

  .contact-heading h1 {
    font-family: "Dela Gothic One", sans-serif;
    font-size: clamp(2.1rem, 10vw, 3rem);
    line-height: 1;
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }

  .contact-heading p {
    max-width: 21rem;
    margin-top: 0.8rem;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .contact-content {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .contact-input {
    width: 100%;
    border: 1px solid #151515;
    background: #fffdfa;
    padding: 0.75rem;
    font-size: 0.85rem;
    font-weight: 400;
    text-transform: none;
    outline: none;
  }

  .contact-input:focus {
    box-shadow: 3px 3px 0 #a3d8e2;
  }

  .contact-submit {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #151515;
    background: #fbe38e;
    padding: 0.7rem 0.8rem;
    font-family: "Space Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 #151515;
  }

  .contact-submit:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #151515;
  }

  .form-note {
    color: #5e5a55;
    font-size: 0.66rem;
    line-height: 1.5;
  }

  .email-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid #151515;
    background: #a3d8e2;
    padding: 1rem;
  }

  .email-card h2 {
    margin-top: 0.6rem;
    font-family: "Dela Gothic One", sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
  }

  .email-card p {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .email-link {
    width: fit-content;
    border-bottom: 1px solid #151515;
    padding-bottom: 0.2rem;
    color: #151515;
    font-family: "Space Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
}
</style>
