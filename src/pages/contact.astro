---
import { ArrowUpRight, Mail } from "lucide-astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact — Théo Genty">
  <section class="contact-page page-arrive">
    <div class="contact-kicker"><span>YOUR TURN</span><span>04 / 04</span></div>
    <header class="contact-heading">
      <span class="mb-3 inline-block border border-black bg-white px-3 py-1 font-mono text-xs font-bold uppercase">
        Got an idea?
      </span>
      <h1>
        Let’s talk about<br />your project<span class="text-[#FF6B6B]">.</span>
      </h1>
      <p>
        Tell me about your project, your ideas, or what you need. I’ll get back to you as soon as I can.
      </p>
    </header>

    <div class="contact-content">
      <form
        id="contact-form"
        class="contact-form"
        action="https://formsubmit.co/theo.genty@icloud.com"
        method="POST"
      >
        <input type="hidden" name="_subject" value="New portfolio message" />

        <label>
          Your name
          <input
            name="name"
            type="text"
            autocomplete="name"
            required
            class="contact-input"
            placeholder="First and last name"
          />
        </label>

        <label>
          Your email address
          <input
            name="email"
            type="email"
            autocomplete="email"
            required
            class="contact-input"
            placeholder="you@example.com"
          />
        </label>

        <label>
          Your message
          <textarea
            name="message"
            rows="5"
            required
            class="contact-input"
            placeholder="Tell me about your project..."
          ></textarea>
        </label>

        <p id="contact-status" class="contact-status" role="status" aria-live="polite"></p>

        <button
          type="submit"
          class="contact-submit"
        >
          <span>Send message</span> <ArrowUpRight size={18} />
        </button>
        <p class="form-note">
          Your message is sent securely through FormSubmit and may be stored there for up to 30 days.
        </p>
      </form>

      <aside class="email-card">
        <div>
          <Mail size={24} strokeWidth={2.4} />
          <h2>Prefer email?</h2>
          <p>
            Get in touch directly. I’d be happy to hear from you.
          </p>
        </div>
        <a
          href="mailto:theo.genty@icloud.com"
          class="email-link"
        >
          theo.genty@icloud.com
        </a>
      </aside>
    </div>
  </section>

  <script>
    function setupContactForm() {
      const form = document.querySelector<HTMLFormElement>("#contact-form");
      const status = document.querySelector<HTMLElement>("#contact-status");
      const submitButton = form?.querySelector<HTMLButtonElement>('[type="submit"]');
      const submitLabel = submitButton?.querySelector("span");
      if (!form || !status || !submitButton || !submitLabel || form.dataset.ready === "true") return;

      form.dataset.ready = "true";
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity() || form.dataset.submitting === "true") return;

        const values = new FormData(form);
        const payload = {
          name: String(values.get("name") ?? "").trim(),
          email: String(values.get("email") ?? "").trim(),
          message: String(values.get("message") ?? "").trim(),
          _subject: String(values.get("_subject") ?? "New portfolio message"),
        };

        form.dataset.submitting = "true";
        submitButton.disabled = true;
        submitLabel.textContent = "Sending...";
        status.dataset.state = "pending";
        status.textContent = "Sending your message…";

        try {
          const response = await fetch("https://formsubmit.co/ajax/theo.genty@icloud.com", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          });
          const result: { success?: boolean | string; message?: string } = await response.json();

          if (!response.ok || String(result.success).toLowerCase() !== "true") {
            const serviceMessage = result.message?.trim();
            if (serviceMessage && /activat/i.test(serviceMessage)) {
              throw new Error("FormSubmit needs to be activated first. Check theo.genty@icloud.com for its confirmation email, then try again.");
            }
            throw new Error(serviceMessage || "The message was not accepted. Please try again or email me directly.");
          }

          status.dataset.state = "success";
          status.textContent = "Message sent! Thanks for getting in touch — I’ll reply as soon as I can.";
          form.reset();
        } catch (error) {
          status.dataset.state = "error";
          status.textContent = error instanceof Error
            ? error.message
            : "Your message couldn’t be sent. Check your connection and try again, or email me directly.";
        } finally {
          form.dataset.submitting = "false";
          submitButton.disabled = false;
          submitLabel.textContent = "Send message";
        }
      });
    }

    document.addEventListener("astro:page-load", setupContactForm);
    setupContactForm();
  </script>
</Layout>

<style>
  .contact-page {
    padding-bottom: 1rem;
  }

  .contact-kicker {
    display: flex;
    justify-content: space-between;
    padding: 0.2rem 0 0.8rem;
    font-family: "Space Mono", monospace;
    font-size: 0.55rem;
    font-weight: 700;
  }

  .contact-heading {
    border: 1.5px solid #151515;
    background: #7dffb3;
    padding: 1rem;
    box-shadow: 4px 4px 0 #151515;
  }

  .contact-heading h1 {
    font-family: "Dela Gothic One", sans-serif;
    font-size: clamp(2.1rem, 10vw, 3rem);
    line-height: 1;
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }

  .contact-heading p {
    max-width: 21rem;
    margin-top: 0.8rem;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .contact-content {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .contact-input {
    width: 100%;
    border: 1px solid #151515;
    background: #fffdfa;
    padding: 0.75rem;
    font-size: 0.85rem;
    font-weight: 400;
    text-transform: none;
    outline: none;
  }

  .contact-input:focus {
    background: #fff;
    box-shadow: 4px 4px 0 #a3d8e2;
  }

  .contact-submit {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #151515;
    background: #fbe38e;
    padding: 0.7rem 0.8rem;
    font-family: "Space Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 #151515;
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .contact-submit:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #151515;
  }

  .contact-submit:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .contact-status {
    min-height: 1.25rem;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .contact-status[data-state="success"] {
    color: #137344;
  }

  .contact-status[data-state="error"] {
    color: #b42318;
  }

  @media (hover: hover) {
    .contact-submit:hover {
      transform: translate(-2px, -2px);
      background: #7dffb3;
      box-shadow: 5px 5px 0 #151515;
    }

    .email-card {
      transition: transform 220ms ease;
    }

    .email-card:hover {
      transform: rotate(-1deg);
    }
  }

  .form-note {
    color: #5e5a55;
    font-size: 0.66rem;
    line-height: 1.5;
  }

  .email-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid #151515;
    background: #a3d8e2;
    padding: 1rem;
  }

  .email-card h2 {
    margin-top: 0.6rem;
    font-family: "Dela Gothic One", sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
  }

  .email-card p {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .email-link {
    width: fit-content;
    border-bottom: 1px solid #151515;
    padding-bottom: 0.2rem;
    color: #151515;
    font-family: "Space Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
}
</style>
