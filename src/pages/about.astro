---
import Layout from "../layouts/Layout.astro";
---

<Layout title="À propos — Théo">
  <section class="max-w-2xl mx-auto flex flex-col gap-6">
    
    <!-- En-tête de la page About -->
    <div class="bg-white border-2 border-black p-6 shadow-[4px_4px_0px_#000]">
      <span class="inline-block px-2.5 py-1 text-xs font-black uppercase bg-[#7DFFB3] border border-black mb-3">
        Bio & Parcours
      </span>
      <h1 class="text-3xl font-black uppercase tracking-tight">
        À propos de moi
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-black/90">
        Développeur & Web Designer passionné par le néo-brutalisme, les interfaces réactives et les animations soignées.
      </p>
    </div>

    <!-- Exemple d'un lien interne dans la page qui utilise aussi le rideau -->
    <div class="flex gap-4">
      <a
        href="/projets"
        data-curtain-link
        data-curtain-color="#A3D8E2"
        data-direction="left"
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#A3D8E2] border-2 border-black font-black uppercase text-xs shadow-[3px_3px_0px_#000] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0px_#000] transition-all"
      >
        Voir mes réalisations →
      </a>
    </div>

  </section>
</Layout>