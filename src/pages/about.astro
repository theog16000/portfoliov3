---
import Layout from "../layouts/Layout.astro";
---

<Layout title="À propos — Théo">
  <section class="neo-card mb-8 gap-4">
    <span class="self-start px-2.5 py-1 text-xs font-black uppercase bg-[#7DFFB3] border border-black">
      Bio & Parcours
    </span>
    <h1 class="neo-title text-outline">ABOUT</h1>
    <p class="text-sm leading-relaxed">
      Développeur & Web Designer passionné par le néo-brutalisme, les interfaces réactives et les animations soignées.
    </p>
    <a
      href="/projets"
      aria-label="PROJETS"
      class="inline-flex items-center gap-2 self-start px-4 py-2.5 bg-[#A3D8E2] border-2 border-black font-black uppercase text-xs shadow-[3px_3px_0px_#000] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all"
    >
      Voir mes réalisations →
    </a>
  </section>
</Layout>
