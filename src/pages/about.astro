---
import { ArrowUpRight } from "lucide-astro";
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/site";
---

<Layout title="About — Théo Genty">
  <article class="about-page page-arrive">
    <div class="page-label"><span>THE HUMAN BEHIND THE PIXELS</span><span>01 / 04</span></div>

    <header class="about-hero">
      <img src={withBase("/images/theo.webp")} alt="Illustrated portrait of Théo Genty" />
      <div>
        <span class="about-note">NICE TO MEET YOU!</span>
        <h1>NOT A<br />ROBOT.<br /><em>JUST THÉO.</em></h1>
      </div>
    </header>

    <section class="about-story">
      <span class="section-number">A BIT ABOUT ME</span>
      <p>
        I’m a developer and web designer who loves expressive layouts, playful details, and websites that feel like they belong to real people.
      </p>
      <p>
        I bring design and code together to make clear, memorable experiences — from the first sketch to the final interaction.
      </p>
    </section>

    <section class="about-facts">
      <div><strong>01</strong><span>Design with character</span></div>
      <div><strong>02</strong><span>Thoughtful interactions</span></div>
      <div><strong>03</strong><span>Built for every screen</span></div>
    </section>

    <a href={withBase("/projets")} class="about-link">
      TAKE A LOOK AT MY WORK <ArrowUpRight size={18} />
    </a>
  </article>
</Layout>

<style>
  .about-page {
    padding-bottom: 1rem;
  }

  .page-label {
    display: flex;
    justify-content: space-between;
    padding: 0.2rem 0 0.8rem;
    font-family: "Space Mono", monospace;
    font-size: 0.55rem;
    font-weight: 700;
  }

  .about-hero {
    position: relative;
    display: flex;
    min-height: 16rem;
    align-items: end;
    overflow: hidden;
    border: 1.5px solid #151515;
    background: #a3d8e2;
    padding: 1rem;
    box-shadow: 4px 4px 0 #151515;
  }

  .about-hero img {
    position: absolute;
    right: -0.75rem;
    bottom: -1.5rem;
    width: 11rem;
    height: 11rem;
    border: 1.5px solid #151515;
    border-radius: 50%;
    background: #fbe38e;
    object-fit: cover;
    transform: rotate(7deg);
  }

  .about-hero > div {
    position: relative;
    z-index: 1;
  }

  .about-note,
  .section-number {
    font-family: "Space Mono", monospace;
    font-size: 0.57rem;
    font-weight: 700;
  }

  .about-hero h1 {
    margin-top: 0.4rem;
    font-family: "Dela Gothic One", sans-serif;
    font-size: 2.55rem;
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  .about-hero h1 em {
    color: #fffdfa;
    font-style: normal;
    -webkit-text-stroke: 1px #151515;
    text-shadow: 2px 2px 0 #151515;
  }

  .about-story {
    display: grid;
    gap: 0.8rem;
    border-bottom: 1px solid #151515;
    padding: 1.5rem 0;
  }

  .about-story p {
    max-width: 34rem;
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .about-facts {
    display: grid;
    margin-top: 1rem;
  }

  .about-facts div {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid #15151540;
    padding: 0.75rem 0;
    font-size: 0.78rem;
  }

  .about-facts strong {
    color: #ff6b6b;
    font-family: "Dela Gothic One", sans-serif;
    font-size: 1.05rem;
  }

  .about-link {
    display: flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    border: 1.5px solid #151515;
    background: #7dffb3;
    padding: 0.6rem 0.8rem;
    box-shadow: 3px 3px 0 #151515;
    color: #151515;
    font-family: "Space Mono", monospace;
    font-size: 0.65rem;
    font-weight: 700;
    text-decoration: none;
  }
</style>
