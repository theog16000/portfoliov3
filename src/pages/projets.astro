---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const works = (await getCollection("works")).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
const categories = ["ALL", ...new Set(works.map((w) => w.data.category).filter(Boolean))];
---

<Layout title="Projets — Théo">
  <section class="flex flex-col gap-6 pb-10">
    <div class="neo-card text-center">
      <h1 class="font-dela text-3xl uppercase tracking-[-0.011em]">
        MY <span class="bg-[#7DFFB3] px-2 border-2 border-black">PROJECTS</span>
      </h1>
      <p class="mt-2 text-sm font-medium text-gray-700">
        Découvrez l'ensemble de mes réalisations.
      </p>
    </div>

    <div id="filters" class="flex flex-wrap justify-center gap-2">
      {categories.map((category, i) => (
        <button
          type="button"
          data-filter={String(category).toLowerCase()}
          class:list={[
            "filter-btn px-4 py-2 text-xs font-dela border-[3px] border-black shadow-[3px_3px_0px_#000000] uppercase active:translate-x-0.5 active:translate-y-0.5 active:shadow-none",
            i === 0 ? "is-active bg-[#FF94B9]" : "bg-[#F5F5F5]",
          ]}
        >
          {category}
        </button>
      ))}
    </div>

    <div class="flex flex-col gap-4">
      {works.map((work) => {
        const category = work.data.category ? work.data.category.toLowerCase() : "uncategorized";
        const slug = work.id.replace(/\.md$/, "");
        const tags = work.data.tags ?? [];

        return (
          <article
            data-category={category}
            class="project-card neo-card bg-[#F5F5F5] gap-3"
          >
            <div class="h-40 bg-gray-300 border-2 border-black overflow-hidden">
              {work.data.image ? (
                <img src={work.data.image} alt={work.data.title} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-xs font-dela bg-[#A3D8E2]">
                  NO IMAGE
                </div>
              )}
            </div>

            <h3 class="font-dela text-lg uppercase truncate">{work.data.title}</h3>

            {work.data.description && (
              <p class="text-xs text-gray-700 line-clamp-3">{work.data.description}</p>
            )}

            {tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {tags.map((tag: string) => (
                  <span class="text-[10px] font-bold border border-black bg-[#7DFFB3] px-2 py-0.5 shadow-[1px_1px_0px_#000000] uppercase">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <a
              href={`/works/${slug}`}
              class="w-full text-center font-dela text-xs border-2 border-black bg-[#A3D8E2] py-2 shadow-[2px_2px_0px_#000000] uppercase"
            >
              VIEW PROJECT ➔
            </a>
          </article>
        );
      })}
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const filters = document.getElementById("filters");
    if (!filters) return;

    const buttons = filters.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".project-card");

    filters.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".filter-btn");
      if (!button) return;

      const filter = button.dataset.filter;
      buttons.forEach((btn) => {
        btn.classList.toggle("is-active", btn === button);
        btn.classList.toggle("bg-[#FF94B9]", btn === button);
        btn.classList.toggle("bg-[#F5F5F5]", btn !== button);
      });

      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.classList.toggle("hidden", !show);
      });
    });
  });
</script>
