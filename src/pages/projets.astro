---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/site';

// 1. Fetch the works collection
const allWorks = await getCollection('works');

// Sort by order when set; otherwise keep the default order
const sortedWorks = allWorks.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// 2. Build a unique list of categories from the Markdown frontmatter
const rawCategories = sortedWorks.map(work => work.data.category).filter(Boolean);
const categories = ['ALL', ...new Set(rawCategories)];
---

<Layout
  title="Projets web de Théo Genty, designer et développeur"
  description="Parcourez les projets de Théo Genty : création et refonte de sites web, design d’interface et développement front-end."
>
  <section class="projects-page page-arrive">
    <div class="projects-kicker"><span>PROJECTS</span><span>02 / 04</span></div>
    <header class="projects-heading">
      <span>DESIGN + CODE</span>
      <h1>THINGS<br />I’VE <em>MADE.</em></h1>
      <p>Two projects I’ve designed and built. Tap through for the details.</p>
    </header>

    <!-- Dynamic filters -->
    <div class="project-filters flex flex-wrap gap-2 mb-5" aria-label="Filter projects">
      {categories.map((category, index) => (
        <button
          data-filter={category.toLowerCase()}
          aria-pressed={index === 0 ? "true" : "false"}
          class={`filter-btn px-3 py-2 text-[10px] font-bold border border-black transition-all active:scale-95 uppercase cursor-pointer ${
            index === 0 ? "bg-[#FF94B9]" : "bg-[#F5F5F5]"
          }`}
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Project grid -->
    <p class="project-swipe-hint">PICK A FILTER, THEN SWIPE <span aria-hidden="true">↔</span></p>
    <div class="project-grid" aria-label="Projects. Swipe horizontally to browse." tabindex="0">
      {sortedWorks.map((work) => {
        const category = work.data.category ? work.data.category.toLowerCase() : 'uncategorized';
        const workSlug = (work.id || work.slug).replace(/\.md$/, '');

        return (
          <article
            data-category={category}
            class="project-card flex flex-col"
          >
            <div>
              <!-- Image preview -->
              <div class="project-image h-48 bg-gray-300 border border-black w-full overflow-hidden mb-3">
                {work.data.image ? (
                  <img src={withBase(work.data.image)} alt={work.data.title} class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-xs font-dela bg-[#A3D8E2]">
                    NO IMAGE
                  </div>
                )}
              </div>

              <!-- Title -->
              <h3 class="font-dela text-xl uppercase mb-1 truncate">
                {work.data.title}
              </h3>

              <!-- Description -->
              {work.data.description && (
                <p class="text-sm text-gray-700 line-clamp-3 mb-3">
                  {work.data.description}
                </p>
              )}

              <!-- Category and tags -->
              {work.data.tags && work.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {work.data.tags.map((tag: string) => (
                    <span class="text-[10px] font-bold border border-black bg-[#7DFFB3] px-2 py-0.5 uppercase">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <!-- Project link -->
            <a 
              href={withBase(`/works/${workSlug}`)}
              class="project-link w-full text-left font-mono text-xs border-y border-black py-3 uppercase block mt-1"
            >
              VIEW PROJECT ➔
            </a>
          </article>
        );
      })}
    </div>

  </section>

  <!-- Client-side project filtering -->
  <script>
    document.addEventListener('astro:page-load', initFilters);
    document.addEventListener('DOMContentLoaded', initFilters);

    function initFilters() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('.project-card');

      buttons.forEach(button => {
        if (button.dataset.filterReady === 'true') return;
        button.dataset.filterReady = 'true';
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-filter');

          buttons.forEach(btn => {
            btn.classList.remove('bg-[#FF94B9]');
            btn.classList.add('bg-[#F5F5F5]');
            btn.setAttribute('aria-pressed', 'false');
          });
          button.classList.add('bg-[#FF94B9]');
          button.classList.remove('bg-[#F5F5F5]');
          button.setAttribute('aria-pressed', 'true');

          cards.forEach(card => {
            const category = card.getAttribute('data-category');
            if (filter === 'all' || category === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }
  </script>
</Layout>

<style>
  .projects-page {
    padding-bottom: 1rem;
  }

  .project-filters {
    overflow-x: auto;
    flex-wrap: nowrap;
    margin-top: 1.5rem;
    padding: 0.2rem 0.15rem 0.55rem;
    scrollbar-width: none;
  }

  .project-filters::-webkit-scrollbar {
    display: none;
  }

  .project-swipe-hint {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.55rem;
    font-family: "Space Mono", monospace;
    font-size: 0.53rem;
    font-weight: 700;
  }

  .project-swipe-hint span {
    font-size: 1.1rem;
    animation: projects-nudge 1.8s ease-in-out infinite;
  }

  .project-grid {
    display: grid;
    grid-auto-columns: minmax(82%, 1fr);
    grid-auto-flow: column;
    gap: 0.9rem;
    margin-right: -1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 0.35rem 1rem 1rem 0.15rem;
    scroll-padding-inline: 0.15rem;
    scroll-snap-type: x mandatory;
    scrollbar-color: #151515 #f4efe9;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .filter-btn {
    flex: 0 0 auto;
    min-height: 2.5rem;
    box-shadow: 2px 2px 0 #151515;
  }

  .filter-btn:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  .projects-kicker {
    display: flex;
    justify-content: space-between;
    padding: 0.2rem 0 0.8rem;
    font-family: "Space Mono", monospace;
    font-size: 0.55rem;
    font-weight: 700;
  }

  .projects-heading {
    position: relative;
    overflow: hidden;
    border: 1.5px solid #151515;
    background: #ffaaa6;
    padding: 1rem;
    box-shadow: 4px 4px 0 #151515;
  }

  .projects-heading > span {
    font-family: "Space Mono", monospace;
    font-size: 0.58rem;
    font-weight: 700;
  }

  .projects-heading h1 {
    margin-top: 0.8rem;
    font-family: "Dela Gothic One", sans-serif;
    font-size: clamp(2.75rem, 13vw, 4rem);
    line-height: 0.92;
    letter-spacing: -0.08em;
  }

  .projects-heading h1 em {
    color: #fffdfa;
    font-style: normal;
    -webkit-text-stroke: 1px #151515;
    text-shadow: 3px 3px 0 #151515;
  }

  .projects-heading p {
    max-width: 15rem;
    margin-top: 0.85rem;
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .project-card {
    min-width: 0;
    scroll-snap-align: start;
    border: 1.5px solid #151515;
    background: #fffdfa;
    padding: 0.6rem 0.6rem 1rem;
    box-shadow: 3px 3px 0 #151515;
    transform: rotate(-1deg);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .project-card:nth-child(even) {
    transform: rotate(1deg);
  }

  .project-card[style*="display: none"] {
    pointer-events: none;
  }

  .project-card:active,
  .project-card:nth-child(even):active {
    transform: rotate(0) scale(0.985);
    box-shadow: 1px 1px 0 #151515;
  }

  .project-card h3 {
    margin-top: 0.8rem;
  }

  .project-card > div:first-child {
    flex: 1;
  }

  .project-card .project-image {
    margin-bottom: 0.65rem;
  }

  .project-link {
    transition: padding-left 180ms ease, color 180ms ease;
  }

  @media (hover: hover) {
    .project-card:hover,
    .project-card:nth-child(even):hover {
      transform: rotate(0) translateY(-3px);
      box-shadow: 5px 5px 0 #151515;
    }

    .project-link:hover {
      padding-left: 0.6rem;
      color: #ff6b6b;
    }
  }

  @keyframes projects-nudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  .project-image {
    background-color: #a3d8e2;
  }

  .project-image img {
    transition: transform 400ms ease;
  }

  .project-card:active .project-image img {
    transform: scale(1.035);
  }

  .project-link {
    color: #151515;
    text-decoration: none;
  }
</style>