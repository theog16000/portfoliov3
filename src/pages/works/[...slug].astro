---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getCanonicalUrl, withBase } from '../../utils/site';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => {
    const id = work.id.replace(/\.md$/, '');
    return {
      params: { slug: id },
      props: { work },
    };
  });
}

const { work } = Astro.props;

if (!work) {
  return Astro.redirect('/404');
}

const { Content } = await render(work);
---

<Layout
  title={`${work.data.title} — Projet de Théo Genty`}
  description={work.data.description ?? `${work.data.title} : projet de design et de développement web réalisé par Théo Genty.`}
  image={work.data.image}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: work.data.title,
    description: work.data.description,
    image: work.data.image,
    url: getCanonicalUrl(Astro.url.pathname),
    creator: {
      "@type": "Person",
      name: "Théo Genty",
      url: "https://theogenty.fr/",
    },
    keywords: work.data.tags?.join(", "),
    isPartOf: "https://theogenty.fr/",
  }}
>
  <section class="project-detail page-arrive">
    <div class="detail-kicker"><span>PROJECT FILE</span><span>03 / 04</span></div>
    
    <!-- Back link -->
    <a 
      href={withBase("/projets")}
      class="detail-back inline-flex items-center gap-2 mb-5 font-mono text-xs border border-black bg-white px-3 py-2 transition-colors hover:bg-[#FF94B9] uppercase"
    >
      ← BACK TO PROJECTS
    </a>

    <!-- Project details -->
    <article class="detail-card">
      
      <!-- Category and tags -->
      <div class="flex flex-wrap gap-2 mb-6">
        {work.data.category && (
          <span class="text-xs font-bold border-2 border-black bg-[#FF94B9] px-3 py-1 shadow-[2px_2px_0px_#000000] uppercase">
            {work.data.category}
          </span>
        )}
        {work.data.tags?.map((tag: string) => (
          <span class="text-xs font-bold border-2 border-black bg-[#7DFFB3] px-3 py-1 shadow-[2px_2px_0px_#000000] uppercase">
            {tag}
          </span>
        ))}
      </div>

      <!-- Project title -->
      <h1 class="detail-title">
        {work.data.title}
      </h1>

      <!-- Short description -->
      {work.data.description && (
        <p class="detail-description">
          {work.data.description}
        </p>
      )}

      <!-- Main image / mockup -->
      {work.data.image && (
        <div class="detail-image">
          <img 
            src={withBase(work.data.image)}
            alt={work.data.title} 
            class="w-full h-full object-cover" 
          />
        </div>
      )}

      <!-- Markdown project content -->
      <div class="prose prose-lg max-w-none font-medium text-gray-800 mb-8 border-t border-black pt-5">
        <Content />
      </div>

      <!-- External project link -->
      {work.data.link && (
        <div class="pt-4 border-t-2 border-black flex justify-start">
          <a 
            href={work.data.link} 
            target="_blank" 
            rel="noopener noreferrer"
            class="detail-visit inline-block font-mono text-xs border border-black bg-[#A3D8E2] px-4 py-3 transition-colors hover:bg-[#FF94B9] uppercase"
          >
            VISIT THE WEBSITE ➔
          </a>
        </div>
      )}

    </article>
  </section>
</Layout>

<style>
  .project-detail {
    padding-bottom: 1rem;
  }

  .detail-kicker {
    display: flex;
    justify-content: space-between;
    padding: 0.2rem 0 0.8rem;
    font-family: "Space Mono", monospace;
    font-size: 0.55rem;
    font-weight: 700;
  }

  .detail-back {
    color: #151515;
    text-decoration: none;
  }

  .detail-card {
    border: 1.5px solid #151515;
    background: #fffdfa;
    padding: 1rem;
    box-shadow: 4px 4px 0 #151515;
  }

  .detail-title {
    margin-bottom: 0.8rem;
    font-family: "Dela Gothic One", sans-serif;
    font-size: clamp(2rem, 10vw, 3rem);
    line-height: 1;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .detail-description {
    margin-bottom: 1.2rem;
    border-left: 3px solid #ff6b6b;
    padding-left: 0.75rem;
    color: #343434;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .detail-image {
    width: 100%;
    height: 13rem;
    overflow: hidden;
    margin-bottom: 1.3rem;
    border: 1px solid #151515;
    background: #a3d8e2;
  }

  .detail-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-visit {
    color: #151515;
    text-decoration: none;
  }
</style>