---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const works = await getCollection("works");
  return works.map((work) => ({
    params: { slug: work.id.replace(/\.md$/, "") },
    props: { work },
  }));
}

const { work } = Astro.props;
if (!work) return Astro.redirect("/projets");

const { Content } = await render(work);
---

<Layout title={work.data.title}>
  <section class="max-w-sm mx-auto pb-10">
    <a
      href="/projets"
      class="inline-flex items-center gap-2 mb-6 font-dela text-xs border-2 border-black bg-[#F5F5F5] px-4 py-2 shadow-[3px_3px_0px_#000000] uppercase"
    >
      ← RETOUR
    </a>

    <article class="neo-card gap-4">
      <div class="flex flex-wrap gap-2">
        {work.data.category && (
          <span class="text-xs font-bold border-2 border-black bg-[#FF94B9] px-3 py-1 shadow-[2px_2px_0px_#000000] uppercase">
            {work.data.category}
          </span>
        )}
        {work.data.tags?.map((tag: string) => (
          <span class="text-xs font-bold border-2 border-black bg-[#7DFFB3] px-3 py-1 shadow-[2px_2px_0px_#000000] uppercase">
            {tag}
          </span>
        ))}
      </div>

      <h1 class="font-dela text-3xl uppercase tracking-tight">{work.data.title}</h1>

      {work.data.description && (
        <p class="text-sm font-medium border-l-4 border-black pl-3">{work.data.description}</p>
      )}

      {work.data.image && (
        <div class="border-2 border-black h-52 w-full overflow-hidden shadow-[4px_4px_0px_#000000]">
          <img src={work.data.image} alt={work.data.title} class="w-full h-full object-cover" />
        </div>
      )}

      <div class="prose max-w-none text-sm border-t-2 border-black pt-4">
        <Content />
      </div>

      {work.data.link && (
        <a
          href={work.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block font-dela text-xs border-2 border-black bg-[#A3D8E2] px-5 py-3 shadow-[4px_4px_0px_#000000] uppercase"
        >
          VISITER LE SITE ➔
        </a>
      )}
    </article>
  </section>
</Layout>
