---
import { getCollection } from "astro:content";
import { ArrowUpRight } from "lucide-astro";
import { withBase } from "../utils/site";

const works = await getCollection("works");
const sortedWorks = works.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section id="selected-work" class="work-section page-arrive">
  <div class="work-heading">
    <div>
      <span>03 / PROJECTS</span>
      <h2>TWO<br />PROJECTS.</h2>
    </div>
    <a href={withBase("/projets")} aria-label="See all projects">
      ALL WORK <ArrowUpRight size={17} />
    </a>
  </div>

  <p class="work-hint">SWIPE TO FLIP THROUGH <span aria-hidden="true">↔</span></p>
  <div class="work-list" aria-label="Selected projects. Swipe horizontally to browse." tabindex="0">
    {sortedWorks.map((work, index) => {
      const slug = work.id.replace(/\.md$/, "");
      return (
        <a href={withBase(`/works/${slug}`)} class="work-card">
          <div class="work-image">
            {work.data.image ? (
              <img src={withBase(work.data.image)} alt={work.data.title} loading="lazy" />
            ) : (
              <span class="work-placeholder">0{index + 1}</span>
            )}
            <span class="work-index">0{index + 1}</span>
          </div>
          <div class="work-meta">
            <div>
              <span class="work-category">{work.data.category ?? "Selected work"}</span>
              <h3>{work.data.title}</h3>
              <p>{work.data.description}</p>
            </div>
            <span class="work-arrow" aria-hidden="true"><ArrowUpRight size={20} /></span>
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
  .work-section {
    margin-top: 3.4rem;
  }

  .work-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .work-heading > div > span {
    font-family: "Space Mono", monospace;
    font-size: 0.58rem;
    font-weight: 700;
  }

  .work-heading h2 {
    margin-top: 0.4rem;
    font-family: "Dela Gothic One", sans-serif;
    font-size: 1.8rem;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .work-heading > a {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding-bottom: 0.2rem;
    color: #151515;
    font-family: "Space Mono", monospace;
    font-size: 0.57rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .work-hint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0.2rem 0 0.65rem;
    font-family: "Space Mono", monospace;
    font-size: 0.54rem;
    font-weight: 700;
  }

  .work-hint span {
    font-size: 1.1rem;
    animation: hint-nudge 1.8s ease-in-out infinite;
  }

  .work-list {
    display: grid;
    grid-auto-columns: minmax(82%, 1fr);
    grid-auto-flow: column;
    gap: 0.9rem;
    margin-right: -1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 0.25rem 1rem 0.9rem 0.15rem;
    scroll-padding-inline: 0.15rem;
    scroll-snap-type: x mandatory;
    scrollbar-color: #151515 #f4efe9;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .work-card {
    display: block;
    min-width: 0;
    scroll-snap-align: start;
    color: #151515;
    text-decoration: none;
    transform: rotate(-1deg);
    transition: transform 220ms ease;
  }

  .work-card:nth-child(even) {
    transform: rotate(1deg);
  }

  .work-image {
    position: relative;
    height: 13rem;
    overflow: hidden;
    border: 1.5px solid #151515;
    background: #a3d8e2;
    box-shadow: 3px 3px 0 #151515;
  }

  .work-card:nth-child(2n) .work-image {
    background: #ffaaa6;
  }

  .work-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .work-card:active .work-image img {
    transform: scale(1.04);
  }

  .work-card:active,
  .work-card:nth-child(even):active {
    transform: rotate(0) scale(0.985);
  }

  .work-index {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    border: 1px solid #151515;
    background: #fffdfa;
    padding: 0.25rem 0.4rem;
    font-family: "Space Mono", monospace;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .work-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    font-family: "Dela Gothic One", sans-serif;
    font-size: 5rem;
    -webkit-text-stroke: 1.5px #151515;
    color: transparent;
  }

  .work-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid #151515;
    padding: 0.65rem 0.1rem 0.8rem;
  }

  .work-category {
    font-family: "Space Mono", monospace;
    font-size: 0.55rem;
    text-transform: uppercase;
  }

  .work-meta h3 {
    margin-top: 0.2rem;
    font-family: "Dela Gothic One", sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
  }

  .work-meta p {
    margin-top: 0.15rem;
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .work-arrow {
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid #151515;
    background: #fbe38e;
    transition: transform 220ms ease, background-color 220ms ease;
  }

  @media (hover: hover) {
    .work-card:hover,
    .work-card:nth-child(even):hover {
      transform: rotate(0) translateY(-4px);
    }

    .work-card:hover .work-arrow {
      transform: rotate(45deg);
      background: #7dffb3;
    }
  }

  @keyframes hint-nudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }
</style>
