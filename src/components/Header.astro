---
import MobileMenu from "./MobileMenu.astro";
import { House, User, BriefcaseBusiness, Github, Linkedin } from "lucide-astro";

const nav = [
  { href: "/", label: "ACCUEIL", color: "#FBE38E", Icon: House },
  { href: "/about", label: "À PROPOS", color: "#7DFFB3", Icon: User },
  { href: "/projets", label: "PROJETS", color: "#A3D8E2", Icon: BriefcaseBusiness },
];

const iconBtn =
  "group flex items-center justify-center w-10 h-10 bg-[#F4EFEA] border-2 border-black shadow-[2px_2px_0px_#000] hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_#000] active:translate-y-0 active:shadow-[1px_1px_0px_#000] transition-all duration-200";
---

<header
  transition:persist="site-header"
  class="fixed top-0 left-0 w-full bg-[#F4EFEA] border-b-2 border-black items-center flex justify-between px-6 py-3 z-50"
>
  <img
    src="/images/theo.webp"
    alt="Photo de profil"
    class="rounded-full border-2 border-black shadow-[2px_2px_0px_#000] w-12 h-12 object-cover shrink-0"
  />

  <nav class="hidden md:flex items-center gap-3 absolute left-1/2 -translate-x-1/2">
    {nav.map(({ href, label, color, Icon }) => (
      <a
        href={href}
        aria-label={label}
        class={`${iconBtn} hover:bg-[var(--c)]`}
        style={`--c: ${color}`}
      >
        <Icon class="w-5 h-5 text-black transition-transform duration-200 group-hover:scale-110" stroke-width={2.2} />
      </a>
    ))}
  </nav>

  <div class="hidden md:flex items-center gap-3">
    <a href="https://github.com/theog16000" target="_blank" rel="noopener noreferrer" aria-label="Profil GitHub" class={iconBtn}>
      <Github class="w-5 h-5 text-black" stroke-width={2.2} />
    </a>
    <a href="https://fr.linkedin.com/in/theogty" target="_blank" rel="noopener noreferrer" aria-label="Profil LinkedIn" class={iconBtn}>
      <Linkedin class="w-5 h-5 text-black" stroke-width={2.2} />
    </a>
    <a href="/contact" aria-label="CONTACT" class="neo-cta px-4 py-2 text-xs">
      WORK TOGETHER !
    </a>
  </div>

  <MobileMenu />
</header>
