---
import Notion from "./icons/notion.svg";
import Figma from "./icons/figma.svg";
import Tailwind from "./icons/tailwind.svg";
import Vue from "./icons/vue.svg";
import Github from "./icons/github.svg";
import Star33 from "./stars/Star33";

const tools = [
  { name: "Figma", icon: Figma },
  { name: "Notion", icon: Notion },
  { name: "Vue", icon: Vue },
  { name: "Tailwind", icon: Tailwind },
  { name: "GitHub", icon: Github },
];
---

<section class="tool-section page-arrive">
  <div class="section-heading">
    <span>01 / TOOLS I USE</span>
    <h2>MY KIT</h2>
  </div>
  <div class="tool-list">
    {tools.map(({ name, icon: Icon }, index) => (
      <div class="tool-item" style={`--tool-index: ${index}`}>
        <span class="tool-number">0{index + 1}</span>
        <Icon class="tool-icon" />
        <span class="tool-name">{name}</span>
        <Star33 className="tool-star" size={26} color="#FF6B6B" stroke="black" strokeWidth={7} aria-hidden="true" />
      </div>
    ))}
  </div>
</section>

<style>
  .tool-section {
    margin-top: 3.2rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .section-heading > span {
    font-family: "Space Mono", monospace;
    font-size: 0.58rem;
    font-weight: 700;
  }

  .section-heading h2 {
    font-family: "Dela Gothic One", sans-serif;
    font-size: 1.6rem;
    line-height: 1;
  }

  .tool-list {
    border-top: 1.5px solid #151515;
  }

  .tool-item {
    display: grid;
    min-height: 3.4rem;
    grid-template-columns: 2rem 1.8rem 1fr 1.2rem;
    align-items: center;
    gap: 0.7rem;
    border-bottom: 1px solid #15151550;
    padding: 0.35rem 0.45rem;
    transition: background-color 180ms ease, padding 180ms ease;
  }

  .tool-item:active {
    padding-inline: 0.75rem;
    background: #a3d8e2;
  }

  .tool-number {
    color: #5e5a55;
    font-family: "Space Mono", monospace;
    font-size: 0.58rem;
  }

  .tool-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .tool-name {
    font-size: 0.85rem;
    font-weight: 700;
  }

  .tool-star {
    display: block;
    overflow: visible;
    transition: transform 300ms ease;
  }

  .tool-item:active .tool-star {
    transform: rotate(90deg);
  }
</style>
