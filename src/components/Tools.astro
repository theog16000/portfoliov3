---
import Star15 from "./stars/Star15.tsx";
import ToolCard from "./ToolCard.astro";
import Notion from "./icons/notion.svg";
import Figma from "./icons/figma.svg";
import Tailwind from "./icons/tailwind.svg";
import Vue from "./icons/vue.svg";
import Github from "./icons/github.svg";

const tools = [Figma, Notion, Vue, Tailwind, Github];
---

<ToolCard title="TOOLS">
  <div class="flex flex-wrap items-center justify-center gap-5 max-w-[250px] mx-auto py-3">
    {tools.map((Icon) => (
      <div class="relative inline-flex items-center justify-center drop-shadow-[3px_3px_0px_#000000]">
        <Star15 className="w-16 h-16" color="#5294FF" stroke="black" strokeWidth={3} />
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <Icon class="w-7 h-7 text-white" />
        </div>
      </div>
    ))}
  </div>
</ToolCard>
