---
import { Instagram, Linkedin, Github, Mail } from "lucide-astro";
import Star40 from "./stars/Star40";

const socials = [
  { href: "https://instagram.com", label: "Instagram", Icon: Instagram, hover: "active:bg-[#F9B5D0]" },
  { href: "https://fr.linkedin.com/in/theogty", label: "LinkedIn", Icon: Linkedin, hover: "active:bg-[#7DD8EC]" },
  { href: "https://github.com/theog16000", label: "GitHub", Icon: Github, hover: "active:bg-[#D6D3D1]" },
  { href: "mailto:theo.genty@icloud.com", label: "Email", Icon: Mail, hover: "active:bg-[#FBD74B]" },
];
---

<section class="neo-card">
  <p class="font-mono font-black text-xs tracking-wider">HELLO. I'M THEO</p>

  <div class="mt-1 leading-none">
    <h1 class="font-dela text-3xl uppercase text-[#F4EFEA] text-outline">
      WEB <span class="text-[#FF6B6B]">DESIGNER</span>
    </h1>
    <h1 class="font-dela text-3xl uppercase text-[#F4EFEA] text-outline">
      & <span class="text-[#7DD8EC]">DEVELOPER</span>
    </h1>
  </div>

  <p class="font-mono font-bold text-[11px] leading-snug mt-2">
    SPECIALIZING IN CREATIVE<br />LANDING PAGES FOR BUSINESSES.
  </p>

  <div class="mt-4 flex items-center justify-between gap-2">
    <a href="/contact" class="neo-cta group flex items-center gap-1.5 px-3 py-1.5 text-[11px]">
      <Star40 color="#5294FF" stroke="black" strokeWidth={10} width={15} height={15} />
      <span>READY TO WORK</span>
      <Star40 color="#5294FF" stroke="black" strokeWidth={10} width={15} height={15} />
    </a>

    <div class="flex items-center gap-1.5">
      {socials.map(({ href, label, Icon, hover }) => (
        <a
          href={href}
          target={href.startsWith("http") ? "_blank" : undefined}
          rel="noopener noreferrer"
          aria-label={label}
          class:list={["neo-icon", hover]}
        >
          <Icon class="w-4 h-4 stroke-[2.5]" />
        </a>
      ))}
    </div>
  </div>
</section>
