---
import { ArrowDownRight, ArrowUpRight, Github, Linkedin } from "lucide-astro";
import { withBase } from "../utils/site";
import Star33 from "./stars/Star33";
import Star40 from "./stars/Star40";
---

<section class="hero page-arrive">
  <div class="hero-top">
    <span>THÉO GENTY / PORTFOLIO</span>
    <span>FRANCE · 2026</span>
  </div>

  <div class="hero-main">
    <div class="hero-copy">
      <p class="hero-hello">WEB DESIGNER &amp; DEVELOPER</p>
      <h1>Hi, I’m<br /><span>Théo.</span></h1>
      <p class="hero-intro">
        I design and build websites. Recent work: Hypnomelia and a dashboard redesign.
      </p>
    </div>
    <div class="portrait-wrap" aria-label="Illustrated portrait of Théo">
      <img src={withBase("/images/theo.webp")} alt="Illustrated portrait of Théo Genty" />
      <span class="portrait-note">yep, that’s me</span>
    </div>
    <Star33 className="hero-spark hero-spark-one" size={48} color="#FBE38E" stroke="black" strokeWidth={8} aria-hidden="true" />
    <Star40 className="hero-spark hero-spark-two" size={32} color="#FF6B6B" stroke="black" strokeWidth={8} aria-hidden="true" />
  </div>

  <div class="hero-bottom">
    <a href={withBase("/contact")} class="hero-contact">
      GET IN TOUCH <ArrowUpRight size={17} />
    </a>
    <div class="hero-socials">
      <a href="https://github.com/theog16000" aria-label="GitHub">
        <Github size={18} />
      </a>
      <a href="https://fr.linkedin.com/in/theogty" aria-label="LinkedIn">
        <Linkedin size={18} />
      </a>
      <a href="#selected-work" aria-label="Scroll to selected work">
        <ArrowDownRight size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border: 1.5px solid #151515;
    background: #ffaaa6;
    box-shadow: 5px 5px 0 #151515;
  }

  .hero-top,
  .hero-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.8rem 0.9rem;
    font-family: "Space Mono", monospace;
    font-size: 0.53rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .hero-top {
    border-bottom: 1.5px solid #151515;
    background: #fffdfa;
  }

  .hero-main {
    position: relative;
    min-height: 29rem;
    padding: 1.5rem 1rem;
    isolation: isolate;
  }

  .hero-main::before {
    position: absolute;
    z-index: -1;
    right: -5rem;
    bottom: 0.5rem;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: #ffffff18;
    content: "";
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-hello {
    margin-bottom: 0.75rem;
    font-family: "Space Mono", monospace;
    font-size: 0.52rem;
    font-weight: 700;
  }

  .hero h1 {
    font-family: "Dela Gothic One", sans-serif;
    font-size: clamp(3.5rem, 17vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: -0.09em;
  }

  .hero h1 span {
    display: inline-block;
    color: #fffdfa;
    -webkit-text-stroke: 1px #151515;
    text-shadow: 4px 4px 0 #151515;
  }

  .hero-intro {
    max-width: 15rem;
    margin-top: 0.9rem;
    border-left: 2px solid #151515;
    padding-left: 0.6rem;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .portrait-wrap {
    position: absolute;
    right: 1.4rem;
    bottom: 1rem;
    width: 9rem;
    height: 9rem;
    transform: rotate(8deg);
  }

  .portrait-wrap img {
    width: 100%;
    height: 100%;
    border: 2px solid #151515;
    border-radius: 48% 52% 44% 56%;
    background: #a3d8e2;
    object-fit: cover;
    box-shadow: 5px 5px 0 #151515;
  }

  .portrait-wrap::before {
    position: absolute;
    inset: -0.4rem;
    border: 1px solid #151515;
    border-radius: 50%;
    content: "";
  }

  .portrait-note {
    position: absolute;
    z-index: 2;
    top: -1.45rem;
    left: -0.3rem;
    transform: rotate(-7deg);
    font-family: "Space Mono", monospace;
    font-size: 0.55rem;
    font-weight: 700;
  }

  .hero-spark {
    position: absolute;
    overflow: visible;
  }

  .hero-spark-one {
    top: 1.2rem;
    right: 1.4rem;
  }

  .hero-spark-two {
    right: 10rem;
    bottom: 2.3rem;
  }

  .hero-bottom {
    min-height: 3.5rem;
    border-top: 1.5px solid #151515;
    background: #fbe38e;
  }

  .hero-contact {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: #151515;
    font-family: "Space Mono", monospace;
    font-size: 0.63rem;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-socials {
    display: flex;
    gap: 0.5rem;
  }

  .hero-socials a {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid #151515;
    color: #151515;
    transition: transform 160ms ease, background-color 160ms ease;
  }

  .hero-socials a:active {
    transform: translate(2px, 2px);
    background: #7dffb3;
  }

  @media (hover: hover) {
    .hero-socials a:hover {
      transform: translate(-2px, -2px) rotate(-5deg);
      background: #7dffb3;
      box-shadow: 3px 3px 0 #151515;
    }

    .portrait-wrap:hover img {
      transform: rotate(4deg) scale(1.04);
    }
  }
</style>
