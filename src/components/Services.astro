---
const services = [
  { label: "WEB DEVELOPMENT", color: "#A3D8E2" },
  { label: "WEB DESIGN", color: "#FBE38E" },
  { label: "RESPONSIVE MOBILE", color: "#FFAAA6" },
  { label: "UI & UX DESIGN", color: "#7DFFB3" },
  { label: "SEO & PERFORMANCE", color: "#C4B5FD" },
];
---

<section class="neo-card">
  <h1 class="neo-title text-outline">SERVICES</h1>
  <div class="mt-5 flex flex-col items-center">
    {services.map(({ label, color }) => (
      <span
        class="border-[3px] border-black w-70 p-4 text-center font-dela text-sm uppercase shadow-[3px_3px_0px_#000000] tracking-[-0.011em] mt-2"
        style={`background-color: ${color}`}
      >
        {label}
      </span>
    ))}
  </div>
</section>
