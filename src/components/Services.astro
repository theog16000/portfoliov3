---
const services = [
  "Web design",
  "Front-end development",
  "Responsive experiences",
  "UI / UX",
  "Performance & SEO",
];
---

<section class="services page-arrive">
  <div class="section-heading">
    <span>02 / WHAT I DO</span>
    <h2>HOW I<br />CAN HELP.</h2>
  </div>
  <ol>
    {services.map((service, index) => (
      <li>
        <span>0{index + 1}</span>
        <strong>{service}</strong>
        <span aria-hidden="true">↗</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .services {
    margin-top: 3.4rem;
    border: 1.5px solid #151515;
    background: #d9cafa;
    padding: 1rem;
    box-shadow: 4px 4px 0 #151515;
  }

  .section-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .section-heading > span {
    padding-top: 0.4rem;
    font-family: "Space Mono", monospace;
    font-size: 0.58rem;
    font-weight: 700;
  }

  .section-heading h2 {
    font-family: "Dela Gothic One", sans-serif;
    font-size: 1.8rem;
    line-height: 0.95;
    text-align: right;
  }

  ol {
    border-top: 1.5px solid #151515;
  }

  li {
    display: grid;
    min-height: 3.2rem;
    grid-template-columns: 2rem 1fr 1rem;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid #15151545;
    font-size: 0.8rem;
  }

  li > span:first-child {
    font-family: "Space Mono", monospace;
    font-size: 0.58rem;
  }

  li > span:last-child {
    font-size: 1rem;
  }
</style>
