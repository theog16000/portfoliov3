---
interface Props {
  title?: string;
}

const { title = "TOOLS" } = Astro.props;
---

<section class="border-2 border-black bg-[#F4EFEA] p-4 shadow-[4px_4px_0px_#000000] mx-auto flex flex-col justify-between max-w-sm w-full">
    <!-- Titre unique géré par le composant -->
    <h1 class="font-dela text-3xl text-[#F4EFEA] tracking-[-0.011em] text-outline">
      {title}
    </h1>

    <!-- Conteneur pour les étoiles et icônes -->
    <div class="mt-4 flex items-center justify-center gap-4 flex-wrap">
      <slot />
    </div>
</section>