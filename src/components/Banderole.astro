---

<div class="ticker" aria-label="Design, code, and the details in between">
  <div class="ticker-track" aria-hidden="true">
    {Array.from({ length: 4 }, () => (
      <span>DESIGN <b>✳</b> CODE <b>✳</b> ONE MORE TINY FIX <b>✳</b></span>
    ))}
  </div>
</div>

<style>
  .ticker {
    width: calc(100% + 2rem);
    margin: 2.5rem -1rem 0;
    overflow: hidden;
    border-block: 1.5px solid #151515;
    background: #7dffb3;
    padding: 0.9rem 0;
  }

  .ticker-track {
    display: flex;
    width: max-content;
  }

  .ticker-track span {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-right: 1rem;
    white-space: nowrap;
    font-family: "Space Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .ticker-track b {
    color: #ff6b6b;
    font-size: 1rem;
  }
</style>
