---
import Star40 from './stars/Star40';
---

<section class="bg-[#7DFFB3] w-screen relative left-1/2 -translate-x-1/2 flex flex-row justify-center items-center h-32 my-6 overflow-hidden">
  <div class="w-full max-w-7xl px-4 sm:px-6 flex justify-between items-center gap-2 sm:gap-4">

    <!-- Étoile gauche -->
    <div class="w-8 sm:w-12 flex justify-start shrink-0">
      <div class="animate-[spin_8s_linear_infinite]">
        <Star40
          size={30}
          color="#FF94B9"
          stroke="black"
          strokeWidth={10}
        />
      </div>
    </div>

    <!-- Titre (réduit sur mobile pour bien espacer les 3 éléments) -->
    <h2 class="text-sm sm:text-xl font-dela tracking-[-0.011em] text-center flex-1 break-words">
      PERSONAL PORTFOLIO
    </h2>

    <!-- Étoile droite -->
    <div class="w-8 sm:w-12 flex justify-end shrink-0">
      <div class="animate-[spin_8s_linear_infinite_reverse]">
        <Star40
          size={30}
          color="#FF94B9"
          stroke="black"
          strokeWidth={10}
        />
      </div>
    </div>

  </div>
</section>