---
import Star33 from "./stars/Star33";
---

<div class="ticker" aria-label="Design, code, and the details in between">
  <div class="ticker-track" aria-hidden="true">
    {Array.from({ length: 4 }, () => (
      <span>
        DESIGN <Star33 className="ticker-star" size={20} color="#FBE38E" stroke="black" strokeWidth={7} />
        CODE <Star33 className="ticker-star" size={20} color="#A3D8E2" stroke="black" strokeWidth={7} />
        ONE MORE TINY FIX <Star33 className="ticker-star" size={20} color="#FF6B6B" stroke="black" strokeWidth={7} />
      </span>
    ))}
  </div>
</div>

<style>
  .ticker {
    width: calc(100% + 2rem);
    margin: 2.5rem -1rem 0;
    overflow: hidden;
    border-block: 1.5px solid #151515;
    background: transparent;
    padding: 0.9rem 0;
  }

  .ticker-track {
    display: flex;
    width: max-content;
  }

  .ticker-track span {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-right: 1rem;
    white-space: nowrap;
    font-family: "Space Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .ticker-star {
    flex: 0 0 auto;
    overflow: visible;
  }
</style>
