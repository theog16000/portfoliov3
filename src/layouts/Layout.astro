---
import Header from "../components/Header.astro";
import { getCanonicalUrl, withBase } from "../utils/site";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Théo Genty, designer et développeur web",
  description = "Je suis Théo Genty, designer et développeur web. Découvrez mes projets de création de sites, de design d’interface et de développement front-end.",
  image = "/images/theo.webp",
  noindex = false,
  structuredData,
} = Astro.props;
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const socialImage = new URL(image, "https://theogenty.fr").href;
const pageStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Théo Genty — Portfolio",
    url: "https://theogenty.fr/",
    inLanguage: ["fr-FR", "en"],
    author: {
      "@type": "Person",
      name: "Théo Genty",
      url: "https://theogenty.fr/",
      jobTitle: "Designer et développeur web",
      image: "https://theogenty.fr/images/theo.webp",
      sameAs: [
        "https://github.com/theog16000",
        "https://fr.linkedin.com/in/theogty",
      ],
    },
  },
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg?v=2")} />
    <link rel="icon" type="image/x-icon" href={withBase("/favicon.ico?v=2")} />
    <meta name="theme-color" content="#f4efe9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Théo Genty — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Portrait illustré de Théo Genty" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />
    <ClientRouter />

    <style is:global>
      /* Disable Astro's native view transition, which interferes with the custom curtain. */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none !important;
        mix-blend-mode: normal !important;
      }

      #curtain-shadow {
        position: fixed;
        inset: 0;
        z-index: 9998;
        pointer-events: none;
        background-color: #000;
        transform: translateY(-101%);
        will-change: transform;
      }

      #curtain-main {
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        background-color: #FBE38E;
        transform: translateY(-101%);
        will-change: transform;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #curtain-loader {
        opacity: 0;
        transform: translateY(10px) scale(0.96);
        text-align: center;
      }

      @keyframes loader-arrive {
        from {
          opacity: 0;
          transform: translateY(10px) scale(0.96);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes loader-orbit {
        to {
          transform: rotate(360deg);
        }
      }

      @keyframes avatar-float {
        0%, 100% {
          transform: translateY(0) rotate(-4deg);
        }
        50% {
          transform: translateY(-5px) rotate(4deg);
        }
      }

      @keyframes loader-progress {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      .curtain-loader__mark {
        position: relative;
        display: grid;
        width: 5.5rem;
        height: 5.5rem;
        margin: 0 auto 1.25rem;
        place-items: center;
        border-radius: 50%;
      }

      .curtain-loader__mark::before {
        position: absolute;
        inset: 0;
        border: 1px dashed currentColor;
        border-radius: 50%;
        content: "";
        animation: loader-orbit 8s linear infinite;
      }

      .curtain-loader__avatar {
        display: block;
        width: 4.25rem;
        height: 4.25rem;
        border: 2px solid currentColor;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 3px 3px 0 #000;
        animation: avatar-float 2.4s ease-in-out infinite;
      }

      .curtain-loader__title {
        display: block;
        font-size: clamp(1.1rem, 5vw, 1.35rem);
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .curtain-loader__track {
        width: min(12rem, calc(100vw - 4rem));
        height: 0.3rem;
        margin: 1rem auto 0;
        overflow: hidden;
        border: 1px solid currentColor;
        border-radius: 999px;
      }

      .curtain-loader__progress {
        display: block;
        width: 100%;
        height: 100%;
        transform: scaleX(0);
        transform-origin: left;
        background: #FF6B6B;
      }

      /* The stacked vertical panels use a shorter, eased motion for a lighter transition. */
      .curtain-in #curtain-shadow {
        transition: transform 680ms cubic-bezier(0.76, 0, 0.24, 1) !important;
        transform: translateY(0) !important;
      }
      .curtain-in #curtain-main {
        transition: transform 760ms cubic-bezier(0.76, 0, 0.24, 1) 70ms !important;
        transform: translateY(0) !important;
      }
      .curtain-in #curtain-loader {
        animation: loader-arrive 380ms cubic-bezier(0.22, 1, 0.36, 1) 260ms both;
      }
      .curtain-in #curtain-loader .curtain-loader__progress {
        animation: loader-progress 620ms cubic-bezier(0.65, 0, 0.35, 1) 120ms both;
      }

      .curtain-out #curtain-shadow {
        transition: transform 680ms cubic-bezier(0.76, 0, 0.24, 1) !important;
        transform: translateY(101%) !important;
      }
      .curtain-out #curtain-main {
        transition: transform 760ms cubic-bezier(0.76, 0, 0.24, 1) 70ms !important;
        transform: translateY(101%) !important;
      }
      .curtain-out #curtain-loader {
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
        transition: opacity 160ms ease-out, transform 220ms ease-out !important;
      }

      @media (prefers-reduced-motion: reduce) {
        .curtain-in #curtain-shadow,
        .curtain-in #curtain-main,
        .curtain-out #curtain-shadow,
        .curtain-out #curtain-main {
          transition-duration: 1ms !important;
          transition-delay: 0ms !important;
        }

        .curtain-in #curtain-loader {
          animation-duration: 1ms;
          animation-delay: 0ms;
        }

        .curtain-loader__mark::before,
        .curtain-loader__avatar {
          animation-duration: 1ms;
        }

        .curtain-in #curtain-loader .curtain-loader__progress {
          animation-duration: 1ms;
          animation-delay: 0ms;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#F4EFE9] text-black flex flex-col overflow-x-hidden">

    <!-- Rideau de transition -->
    <div id="curtain-wrapper" class="pointer-events-none">
      <div id="curtain-shadow" aria-hidden="true"></div>
      <div id="curtain-main" aria-hidden="true">
        <div id="curtain-loader">
          <div class="curtain-loader__mark">
            <img class="curtain-loader__avatar" src={withBase("/images/theo.webp")} alt="Illustrated portrait of Théo" />
          </div>
          <span class="curtain-loader__title">Loading...</span>
          <div class="curtain-loader__track">
            <span class="curtain-loader__progress"></span>
          </div>
        </div>
      </div>
    </div>

    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />

    <details class="accessibility-tools">
      <summary aria-label="Language and accessibility">
        <span aria-hidden="true">Aa</span>
        <span class="sr-only">Accessibility</span>
      </summary>
      <div class="accessibility-panel" role="group" aria-label="Language and accessibility">
        <button id="language-toggle" type="button" aria-label="Switch to French">FR</button>
        <div class="accessibility-text-size">
          <span>Text size</span>
          <button id="text-smaller" type="button" aria-label="Reduce text size">A−</button>
          <button id="text-larger" type="button" aria-label="Increase text size">A+</button>
        </div>
        <button id="dyslexia-toggle" type="button" aria-pressed="false">Dyslexia-friendly font</button>
        <button id="contrast-toggle" type="button" aria-pressed="false">High contrast</button>
        <button id="motion-toggle" type="button" aria-pressed="false">Reduce motion</button>
        <button id="accessibility-reset" type="button">Reset accessibility settings</button>
      </div>
    </details>

    <main id="main-content" tabindex="-1" class="page-shell flex-1 w-full max-w-[480px] mx-auto px-4 pt-[5.3rem] pb-[calc(6.5rem+env(safe-area-inset-bottom))]">
      <slot />
    </main>
    <script>
      import "../utils/accessibility";
    </script>
  </body>
</html>

<style is:global>
  :focus-visible {
    outline: 3px solid #155eef;
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10000;
    transform: translateY(-200%);
    border: 2px solid #151515;
    background: #fffdfa;
    padding: 0.75rem 1rem;
    color: #151515;
    font-family: "Space Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 3px 3px 0 #151515;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .accessibility-tools {
    position: fixed;
    top: 0.75rem;
    right: max(0.75rem, calc((100vw - 1300px) / 2));
    z-index: 60;
    font-family: "Space Mono", monospace;
  }

  .accessibility-tools summary {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    cursor: pointer;
    place-items: center;
    border: 1.5px solid #151515;
    border-radius: 50%;
    background: #fffdfa;
    box-shadow: 2px 2px 0 #151515;
    font-size: 0.78rem;
    font-weight: 700;
    list-style: none;
  }

  .accessibility-tools summary::-webkit-details-marker {
    display: none;
  }

  .accessibility-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    display: grid;
    width: min(18rem, calc(100vw - 1.5rem));
    gap: 0.5rem;
    border: 1.5px solid #151515;
    background: #fffdfa;
    padding: 0.75rem;
    box-shadow: 4px 4px 0 #151515;
  }

  .accessibility-panel button {
    min-height: 2.5rem;
    border: 1px solid #151515;
    background: #f4efe9;
    padding: 0.5rem 0.65rem;
    color: #151515;
    cursor: pointer;
    font: 700 0.65rem "Space Mono", monospace;
    text-align: left;
  }

  .accessibility-panel button[aria-pressed="true"] {
    background: #fbe38e;
  }

  .accessibility-panel #language-toggle {
    background: #a3d8e2;
    text-align: center;
  }

  .accessibility-text-size {
    display: grid;
    grid-template-columns: 1fr 2.5rem 2.5rem;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.62rem;
  }

  .accessibility-text-size button {
    padding-inline: 0.25rem;
    text-align: center;
  }

  html {
    font-size: var(--accessibility-font-size, 16px);
  }

  body.a11y-dyslexia,
  body.a11y-dyslexia * {
    font-family: Arial, Verdana, sans-serif !important;
    letter-spacing: 0.035em;
    word-spacing: 0.08em;
    line-height: 1.6;
  }

  body.a11y-high-contrast {
    background: #fff !important;
    color: #000 !important;
  }

  body.a11y-high-contrast :is(p, span, li, label, h1, h2, h3, h4, h5, h6, small, strong, em) {
    color: #000 !important;
  }

  body.a11y-high-contrast :is(a, button, input, textarea, summary) {
    outline-color: #000;
    text-decoration-thickness: 2px;
  }

  body.a11y-high-contrast :is(a, button, input, textarea, summary):focus-visible {
    outline: 4px solid #000;
    outline-offset: 3px;
  }

  body.a11y-reduced-motion *,
  body.a11y-reduced-motion *::before,
  body.a11y-reduced-motion *::after {
    scroll-behavior: auto !important;
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
  }

  @media (max-width: 679px) {
    .accessibility-tools {
      top: 4.85rem;
      right: 0.65rem;
    }
  }

  @media (min-width: 680px) {
    .page-shell {
  width: min(100% - 10rem, 1300px);
  max-width: none;
  padding: 6.5rem 0 4rem;
    }

    .about-page,
    .projects-page,
    .contact-page,
    .project-detail {
      max-width: 1120px;
      margin-inline: auto;
    }

    .about-hero {
      min-height: 25rem;
      padding: 2.5rem;
    }

    .about-hero img {
      right: 2rem;
      bottom: -2rem;
      width: 22rem;
      height: 22rem;
    }

    .about-hero h1 {
      font-size: clamp(4rem, 8vw, 7rem);
    }

    .about-story {
      grid-template-columns: 12rem 1fr 1fr;
      gap: 2rem;
    }

    .about-facts {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .projects-page {
      max-width: 1280px;
    }

    .projects-heading {
      padding: 2.5rem;
    }

    .projects-heading h1 {
      font-size: clamp(4rem, 8vw, 7rem);
    }

    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      grid-auto-flow: row;
      margin-right: 0;
      overflow: visible;
      padding: 0.5rem 0.25rem 1rem;
    }

    .project-card,
    .project-card:nth-child(even) {
      transform: none;
    }

    .project-card .project-image {
      height: 15rem;
    }

    .project-card h3 {
      white-space: normal;
    }

    .project-card[style*="display: none"] {
      display: none !important;
    }

    .contact-page {
      max-width: 1120px;
    }

    .contact-heading {
      padding: 2.5rem;
    }

    .contact-heading h1 {
      font-size: clamp(3rem, 6vw, 5rem);
    }

    .contact-content {
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.8fr);
      align-items: start;
      gap: 3rem;
    }

    .project-detail {
      max-width: 1000px;
    }

    .detail-card {
      padding: 2rem;
    }

    .detail-image {
      height: 32rem;
    }
  }
</style>
