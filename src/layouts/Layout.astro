---
import Header from "../components/Header.astro";
import { withBase } from "../utils/site";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "Portfolio — Théo Genty" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />

    <style is:global>
      /* Disable Astro's native view transition, which interferes with the custom curtain. */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none !important;
        mix-blend-mode: normal !important;
      }

      #curtain-shadow {
        position: fixed;
        inset: 0;
        z-index: 9998;
        pointer-events: none;
        background-color: #000;
        transform: translateY(-101%);
        will-change: transform;
      }

      #curtain-main {
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        background-color: #FBE38E;
        transform: translateY(-101%);
        will-change: transform;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #curtain-loader {
        opacity: 0;
        transform: translateY(10px) scale(0.96);
        text-align: center;
      }

      @keyframes loader-arrive {
        from {
          opacity: 0;
          transform: translateY(10px) scale(0.96);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes loader-orbit {
        to {
          transform: rotate(360deg);
        }
      }

      @keyframes avatar-float {
        0%, 100% {
          transform: translateY(0) rotate(-4deg);
        }
        50% {
          transform: translateY(-5px) rotate(4deg);
        }
      }

      @keyframes loader-progress {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      .curtain-loader__mark {
        position: relative;
        display: grid;
        width: 5.5rem;
        height: 5.5rem;
        margin: 0 auto 1.25rem;
        place-items: center;
        border-radius: 50%;
      }

      .curtain-loader__mark::before {
        position: absolute;
        inset: 0;
        border: 1px dashed currentColor;
        border-radius: 50%;
        content: "";
        animation: loader-orbit 8s linear infinite;
      }

      .curtain-loader__avatar {
        display: block;
        width: 4.25rem;
        height: 4.25rem;
        border: 2px solid currentColor;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 3px 3px 0 #000;
        animation: avatar-float 2.4s ease-in-out infinite;
      }

      .curtain-loader__title {
        display: block;
        font-size: clamp(1.1rem, 5vw, 1.35rem);
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .curtain-loader__track {
        width: min(12rem, calc(100vw - 4rem));
        height: 0.3rem;
        margin: 1rem auto 0;
        overflow: hidden;
        border: 1px solid currentColor;
        border-radius: 999px;
      }

      .curtain-loader__progress {
        display: block;
        width: 100%;
        height: 100%;
        transform: scaleX(0);
        transform-origin: left;
        background: #FF6B6B;
      }

      /* The stacked vertical panels use a shorter, eased motion for a lighter transition. */
      .curtain-in #curtain-shadow {
        transition: transform 680ms cubic-bezier(0.76, 0, 0.24, 1) !important;
        transform: translateY(0) !important;
      }
      .curtain-in #curtain-main {
        transition: transform 760ms cubic-bezier(0.76, 0, 0.24, 1) 70ms !important;
        transform: translateY(0) !important;
      }
      .curtain-in #curtain-loader {
        animation: loader-arrive 380ms cubic-bezier(0.22, 1, 0.36, 1) 260ms both;
      }
      .curtain-in #curtain-loader .curtain-loader__progress {
        animation: loader-progress 620ms cubic-bezier(0.65, 0, 0.35, 1) 120ms both;
      }

      .curtain-out #curtain-shadow {
        transition: transform 680ms cubic-bezier(0.76, 0, 0.24, 1) !important;
        transform: translateY(101%) !important;
      }
      .curtain-out #curtain-main {
        transition: transform 760ms cubic-bezier(0.76, 0, 0.24, 1) 70ms !important;
        transform: translateY(101%) !important;
      }
      .curtain-out #curtain-loader {
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
        transition: opacity 160ms ease-out, transform 220ms ease-out !important;
      }

      @media (prefers-reduced-motion: reduce) {
        .curtain-in #curtain-shadow,
        .curtain-in #curtain-main,
        .curtain-out #curtain-shadow,
        .curtain-out #curtain-main {
          transition-duration: 1ms !important;
          transition-delay: 0ms !important;
        }

        .curtain-in #curtain-loader {
          animation-duration: 1ms;
          animation-delay: 0ms;
        }

        .curtain-loader__mark::before,
        .curtain-loader__avatar {
          animation-duration: 1ms;
        }

        .curtain-in #curtain-loader .curtain-loader__progress {
          animation-duration: 1ms;
          animation-delay: 0ms;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#F4EFE9] text-black flex flex-col overflow-x-hidden">

    <!-- Desktop notice: the portfolio is currently optimized for mobile only. -->
    <div class="hidden md:flex fixed inset-0 z-[99999] bg-[#7DFFB3] items-center justify-center p-6">
      <div class="border-[4px] border-black bg-[#F4EFEA] p-8 shadow-[8px_8px_0px_#000000] max-w-lg text-center">
        <h1 class="font-dela text-2xl uppercase mb-4">
          SITE UNDER DEVELOPMENT
        </h1>
        <p class="font-medium text-sm md:text-base mb-6 text-gray-800">
          This portfolio is currently optimized for <strong>mobile phones only</strong>.
        </p>
        <span class="text-xs font-bold uppercase bg-[#FF94B9] border-2 border-black py-2 px-4 inline-block shadow-[2px_2px_0px_#000000]">
          Open this link on your smartphone
        </span>
      </div>
    </div>

    <!-- Rideau de transition -->
    <div id="curtain-wrapper" class="pointer-events-none">
      <div id="curtain-shadow" aria-hidden="true"></div>
      <div id="curtain-main" aria-hidden="true">
        <div id="curtain-loader">
          <div class="curtain-loader__mark">
            <img class="curtain-loader__avatar" src={withBase("/images/theo.webp")} alt="Illustrated portrait of Théo" />
          </div>
          <span class="curtain-loader__title">Loading...</span>
          <div class="curtain-loader__track">
            <span class="curtain-loader__progress"></span>
          </div>
        </div>
      </div>
    </div>

    <Header />

    <main class="page-shell flex-1 w-full max-w-[480px] mx-auto px-4 pt-[5.3rem] pb-[calc(6.5rem+env(safe-area-inset-bottom))]">
      <slot />
    </main>
  </body>
</html>
