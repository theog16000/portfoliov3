---
import Header from "../components/Header.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "Théo le Web Designer" } = Astro.props;
---

<html lang="fr" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#E2ECE4" />
    <title>{title}</title>
    <ClientRouter />

    <style is:global>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none !important;
        mix-blend-mode: normal;
      }

      ::view-transition-group(content) {
        overflow: hidden;
      }

      ::view-transition-old(content),
      ::view-transition-new(content) {
        mix-blend-mode: normal;
        height: 100%;
        animation-duration: 0.48s;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        animation-fill-mode: both;
      }

      ::view-transition-old(content) {
        animation-name: page-out-up;
      }
      ::view-transition-new(content) {
        animation-name: page-in-up;
      }

      html[data-nav="back"] ::view-transition-old(content) {
        animation-name: page-out-down;
      }
      html[data-nav="back"] ::view-transition-new(content) {
        animation-name: page-in-down;
      }

      @keyframes page-out-up {
        to { transform: translateY(-24%); opacity: 0; }
      }
      @keyframes page-in-up {
        from { transform: translateY(28%); opacity: 0; }
      }
      @keyframes page-out-down {
        to { transform: translateY(24%); opacity: 0; }
      }
      @keyframes page-in-down {
        from { transform: translateY(-28%); opacity: 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(content),
        ::view-transition-new(content) {
          animation-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body class="min-h-screen bg-[#E2ECE4] text-black flex flex-col overflow-x-hidden">
    <div class="hidden md:flex fixed inset-0 z-[99999] bg-[#7DFFB3] items-center justify-center p-6">
      <div class="border-[4px] border-black bg-[#F4EFEA] p-8 shadow-[8px_8px_0px_#000000] max-w-lg text-center">
        <h1 class="font-dela text-2xl uppercase mb-4">Site en cours de développement</h1>
        <p class="font-medium text-sm mb-6 text-gray-800">
          Ce portfolio est actuellement accessible <strong>uniquement sur téléphone mobile</strong>.
        </p>
        <span class="text-xs font-bold uppercase bg-[#FF94B9] border-2 border-black py-2 px-4 inline-block shadow-[2px_2px_0px_#000000]">
          Ouvrez le lien depuis votre smartphone
        </span>
      </div>
    </div>

    <Header />

    <main
      id="content"
      class="flex-1 max-w-6xl w-full mx-auto pt-24 px-4"
      transition:name="content"
      transition:animate="none"
    >
      <slot />
    </main>
  </body>
</html>

<script>
  const RANK: Record<string, number> = {
    "/": 0,
    "/about": 1,
    "/projets": 2,
    "/contact": 3,
  };

  function rank(pathname: string) {
    if (pathname.startsWith("/works")) return 2.5;
    return RANK[pathname.replace(/\/$/, "") || "/"] ?? 9;
  }

  if (!(window as Window & { __navDir?: boolean }).__navDir) {
    (window as Window & { __navDir?: boolean }).__navDir = true;
    document.addEventListener("astro:before-preparation", ((event: Event) => {
      const e = event as Event & { from: URL; to: URL; direction: string };
      const goingBack =
        e.direction === "back" || rank(e.to.pathname) < rank(e.from.pathname);
      document.documentElement.dataset.nav = goingBack ? "back" : "forward";
    }) as EventListener);
  }
</script>
